# Leave both unset for local development — the app falls back to a local
# SQLite file at data/app.db automatically.
#
# Set both when deploying to Vercel (or any host without persistent local
# disk), pointing at a Turso database. See README.md for setup steps.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Required in production — gates the whole app behind a single shared
# password (this holds financial data, so don't deploy without setting
# these). Locally, if left unset, sign-in is effectively unusable since
# there's no password to check against — that's intentional so you notice.
#
# APP_PASSWORD: the password you'll type to sign in.
# AUTH_SECRET: a long random string used to sign session cookies. Generate
# one with: openssl rand -base64 32 (or `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`)
APP_PASSWORD=
AUTH_SECRET=
